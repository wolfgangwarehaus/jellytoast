<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  MAC APP STORE entitlements — the SANDBOXED build.

  This is a SEPARATE artifact from packaging/macos/entitlements.plist (the
  Developer-ID / notarized-.dmg build). Do NOT mix them:

    .dmg (Developer ID)            .pkg (Mac App Store)
    - hardened runtime             - App Sandbox (mandatory)
    - allow-unsigned-exec-memory   - NO JIT entitlements (libmpv built w/o Lua)
    - disable-library-validation   - NO disable-library-validation
                                     (re-sign every dylib with our own
                                      Apple Distribution Team ID instead;
                                      disable-library-validation is rejected
                                      on MAS and crashes on macOS 26 Tahoe)

  The sandbox is deny-by-default. These are the ONLY entitlements jellytoast
  needs (verified research — see packaging/macos/MAS_SESSION.md):

  - app-sandbox: required for the Mac App Store.
  - network.client: outbound to the Jellyfin/Subsonic server + cast targets.
  - network.server: the local cast-proxy HTTP listener (port 8943) + serving
    offline blobs. NB: LAN multicast/Bonjour discovery needs NOTHING beyond
    these on macOS — the iOS com.apple.developer.networking.multicast
    entitlement is "not applicable on the Mac"; discovery is gated only by the
    runtime macOS 15+ Local Network privacy prompt (declared via
    NSLocalNetworkUsageDescription + NSBonjourServices in Info.plist, not here).
  - files.user-selected.read-write + bookmarks.app-scope: for a user-chosen
    music/downloads folder OUTSIDE the container (Phase 6), persisted across
    launches via a security-scoped bookmark. Config/cache/downloads that live
    in standard dirs auto-redirect INTO the container and need no entitlement.

  keychain-access-groups: needed for the keyring (Keychain) credential store
  under the sandbox. The $(AppIdentifierPrefix) is substituted at sign time;
  the dual-store AES-GCM blob in the (container) QSettings is the fallback.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <!-- keychain-access-groups intentionally NOT declared: the sandbox already
         scopes the app to its own default keychain group, which is all the
         keyring needs. Declaring it explicitly requires the Keychain Sharing
         capability on the App ID + provisioning profile; without that, altool
         rejects the build with a -19241 entitlements/profile mismatch. The
         dual-store AES-GCM blob in (container) QSettings is the fallback. -->
</dict>
</plist>
